<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Auth tokens are encrypted with a device-bound Keystore key,
     so a backup restored to another phone couldn't decrypt them anyway; the
     user restores their account with Google sign-in instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="auth_tokens.xml" />
        <exclude domain="database" path="dramaflix.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="auth_tokens.xml" />
        <exclude domain="database" path="dramaflix.db" />
    </device-transfer>
</data-extraction-rules>
