<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DramaFlix" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Dark window from the very first frame: no white flash before Compose draws. -->
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
